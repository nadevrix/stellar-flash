# ---- Stellar Flash · secuenciador ----
# mock = L1 simulada en memoria (demo local). rpc = Stellar real.
L1_MODE=mock

# Red L1 (testnet por defecto). Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Varios RPC separados por coma = failover automático.
RPC_URLS=https://soroban-testnet.stellar.org

# Contrato flash-bridge desplegado (ver docs/05-contratos-soroban.md#despliegue)
BRIDGE_CONTRACT_ID=
# Secreto de la cuenta secuenciadora (la misma pasada al constructor del contrato). SOLO modo rpc.
SEQUENCER_SECRET=

# Tokens habilitados (contract ids de SAC, p. ej. XLM/USDC). Vacío = todos.
ALLOWED_TOKENS=

DB_PATH=data/flash.db
API_HOST=127.0.0.1
API_PORT=8787

# Lotes
SEAL_INTERVAL_MS=2000
# Medido en testnet (scripts/measure-batch-cost.ts): 54 754 B de datos producen una transacción
# Soroban de 110 416 B, un 2,02x de overhead XDR. El límite por transacción es 132 096 B, así que
# el techo seguro está en ~65 000; 60 000 deja margen. Subirlo hace que commit_batch sea rechazado.
MAX_BATCH_BYTES=60000
MAX_BATCH_TXS=250

# Settlement / salud L1
TICK_MS=1000
HEALTH_PROBE_TIMEOUT_MS=4000
HEALTHY_LEDGER_AGE_SEC=15
DOWN_LEDGER_AGE_SEC=60
SURGE_FEE_STROOPS=2000
MIN_INCLUSION_FEE_STROOPS=200
MAX_INCLUSION_FEE_STROOPS=1000000
MAX_DEFER_MS=60000
CHALLENGE_PERIOD_LEDGERS=20
DEPOSIT_SCAN_START_LEDGER=0
